generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Treatment {
  id                    String   @id
  name                  String
  vitamins              String?
  chemicallyTreatedNote String?  @map("chemically_treated_note")
  generalNote           String?  @map("general_note")
  imageNum              Int?     @map("image_num")
  priceInCents          Int      @default(3500000) @map("price_in_cents")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  ingredients           TreatmentIngredient[]
  benefits              TreatmentBenefit[]
  symptoms              TreatmentSymptom[]
  afroBenefits          AfroBenefit[]
  recommendations       DiagnosisRecommendation[]
  cartItems             CartItem[]

  @@map("treatments")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  names        String
  address      String
  department   String
  city         String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  cartItems    CartItem[]
  orders       Order[]

  @@map("users")
}

model Order {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  reference    String      @unique
  status       String      @default("PENDING")
  totalInCents Int         @map("total_in_cents")
  currency     String      @default("COP")
  wompiTxId           String?   @map("wompi_tx_id")
  purchaseNotifiedAt  DateTime? @map("purchase_notified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String @map("order_id")
  treatmentId    String @map("treatment_id")
  treatmentName  String @map("treatment_name")
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model CartItem {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  treatmentId String   @map("treatment_id")
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([userId, treatmentId])
  @@map("cart_items")
}

model TreatmentIngredient {
  id          Int       @id @default(autoincrement())
  treatmentId String    @map("treatment_id")
  text        String
  sortOrder   Int       @default(0) @map("sort_order")
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("treatment_ingredients")
}

model TreatmentBenefit {
  id          Int       @id @default(autoincrement())
  treatmentId String    @map("treatment_id")
  text        String
  sortOrder   Int       @default(0) @map("sort_order")
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("treatment_benefits")
}

model TreatmentSymptom {
  id          Int       @id @default(autoincrement())
  treatmentId String    @map("treatment_id")
  text        String
  sortOrder   Int       @default(0) @map("sort_order")
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("treatment_symptoms")
}

model AfroBenefit {
  id          Int       @id @default(autoincrement())
  treatmentId String    @map("treatment_id")
  subType     String    @map("sub_type")
  description String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([treatmentId, subType])
  @@map("afro_benefits")
}

model HairType {
  id        String @id
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  @@map("hair_types")
}

model AfroSubType {
  id          String @id
  label       String
  description String
  sortOrder   Int    @default(0) @map("sort_order")

  @@map("afro_sub_types")
}

model FormSymptom {
  id        Int    @id @default(autoincrement())
  value     String @unique
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  @@map("form_symptoms")
}

model DiagnosisSession {
  id            String   @id @default(cuid())
  hairType      String?  @map("hair_type")
  hairTypeLabel String?  @map("hair_type_label")
  afroSubType   String?  @map("afro_sub_type")
  explanation   String
  createdAt     DateTime @default(now()) @map("created_at")

  symptoms        DiagnosisSymptom[]
  recommendations DiagnosisRecommendation[]

  @@map("diagnosis_sessions")
}

model DiagnosisSymptom {
  id        Int              @id @default(autoincrement())
  sessionId String           @map("session_id")
  text      String
  session   DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("diagnosis_symptom_entries")
}

model DiagnosisRecommendation {
  id          Int              @id @default(autoincrement())
  sessionId   String           @map("session_id")
  treatmentId String           @map("treatment_id")
  score       Int
  rank        Int
  session     DiagnosisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  treatment   Treatment        @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("diagnosis_recommendations")
}

model ObservatorySurvey {
  id                      String   @id @default(cuid())
  name                    String
  ageRange                String?  @map("age_range")
  city                    String
  email                   String?
  hairType                String   @map("hair_type")
  afroSubType             String?  @map("afro_sub_type")
  washFrequency           String?  @map("wash_frequency")
  usesHeat                Boolean  @default(false) @map("uses_heat")
  usesChemicals           Boolean  @default(false) @map("uses_chemicals")
  careRoutine             String?  @map("care_routine")
  naturalProductsInterest String?  @map("natural_products_interest")
  wantsRecommendations    Boolean  @default(true) @map("wants_recommendations")
  wantsNewsletter         Boolean  @default(false) @map("wants_newsletter")
  purchaseIntent          String?  @map("purchase_intent")
  compatibilityPercent    Int      @map("compatibility_percent")
  acceptedRecommendation  Boolean  @default(true) @map("accepted_recommendation")
  createdAt               DateTime @default(now()) @map("created_at")

  symptoms        ObservatorySurveySymptom[]
  recommendations ObservatorySurveyRecommendation[]

  @@index([city])
  @@index([createdAt])
  @@map("observatory_surveys")
}

model ObservatorySurveySymptom {
  id       Int               @id @default(autoincrement())
  surveyId String            @map("survey_id")
  text     String
  survey   ObservatorySurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("observatory_survey_symptoms")
}

model ObservatorySurveyRecommendation {
  id            Int               @id @default(autoincrement())
  surveyId      String            @map("survey_id")
  treatmentId   String            @map("treatment_id")
  treatmentName String            @map("treatment_name")
  score         Int
  rank          Int
  survey        ObservatorySurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("observatory_survey_recommendations")
}
